# Several small pinned subgraphs packed together.
a1 -> a2: {source-port: bottom; target-port: bottom}
a2 -> a3: {source-port: top; target-port: left}
b1 -> b2: {source-port: left; target-port: left}
b1 -> b3
c1: {shape: circle}
c1 -> c2: {source-port: top; target-port: bottom}
c2 -> c3: {source-port: right; target-port: right}
d1 -> d2: {source-port: right; target-port: left}
d1 -> d3: {source-port: right; target-port: left}
d1 -> d4: {source-port: right; target-port: left}
e1 -> e2
f1 -> f2 -> f3
